# Postgres connection string (Supabase / Render / local)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/dragondrop
# Schema for the tables (default dragondrop; empty or public = the default schema)
DB_SCHEMA=
# Token from @BotFather for @DragonDrop_Bot
BOT_TOKEN=
# Code for "/admin <code>" in the bot (makes you admin)
ADMIN_CODE=
# Public URL of this server (Render sets RENDER_EXTERNAL_URL automatically)
API_URL=
# Public URL of the Mini App (static site). Empty = same as API_URL
WEB_URL=
# webhook (production) | polling (local) | off
BOT_MODE=
# Optional: comma-separated Telegram ids that are always admins
ADMIN_IDS=
# Optional: main admins (Telegram ids or @usernames) — can't be banned or demoted
OWNER_IDS=
OWNER_USERNAMES=
